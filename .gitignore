# Скомпилированные файлы
*.exe
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib

# Логи и отчёты сборки
*.log
*.exit
*.pid

# Бэкапы и временные файлы
*.bak
*.tmp

# Служебные папки Visual Studio
.vs/
.vscode/

# Логи приложения MediaPopup
MediaPopup-*.log

# Файлы probe
probe-*.txt
probe.exit

# Runtime зависимости (загружаются отдельно через setup-runtime.ps1)
runtime/whisper/
runtime/models/

# Настройки приложения (создаются в %LOCALAPPDATA%)
**/settings.ini

# Результаты проверки сборки (verify-build.ps1)
build-verified.log
build.exit

# Папки конфигураций MSVC
Debug/
Release/

# Переменные окружения и секреты
.env
*.env

# Временные файлы скачивания setup-runtime.ps1
*.part

# Кэши Windows
Thumbs.db
desktop.ini

# Результаты smoke-теста Whisper (регенерируются setup-runtime.ps1)
runtime/smoke/*.txt
runtime/smoke/*.part

# CMake and local compiler output
/build*/
/out/
/obj/
/release/
runtime/downloads/
runtime/smoke/
CMakeCache.txt
CMakeFiles/
Testing/
src/audio/tests/out/
*.err
# Local test build artifacts
src/audio/tests/out/
